# agentHub / local-agent-system 环境变量样例 — 复制为 .env 后按需填写。
# 规则（Evolution v3 M2）：密钥只走环境变量，不入库、不入仓、不用 Keychain。
# 正式名为 LAS_*；旧别名仍兼容（见括号）。

# 生产运行时强制安全边界；本地隔离测试由测试进程显式覆盖为 false。
LAS_PRODUCTION_MODE=true

# ── LLM（OpenAI 兼容端点，hermes-brain 与 kimi/codex adapter 共用）──
# 注意：本文件是宿主机视角（127.0.0.1）；容器内 hermes 由 compose 固定改写为
# host.docker.internal:8317，两侧各取所需，不要在本文件填 host.docker.internal。
LAS_LLM_BASE_URL=http://127.0.0.1:8317/v1        # (KIMI_API_BASE)
LAS_LLM_API_KEY=sk-...                           # (CLIPROXY_API_KEY)
LAS_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash      # (KIMI_MODEL)

# ── 状态与工作区 ──
LAS_WORKSPACE=~/AgentWorkspace                   # (AGENT_WORKSPACE)
# 数据库（Evolution v3 §4）：compose 默认 postgresql://agenthub:***@127.0.0.1:5432/agenthub
# 轻量/单机回退 sqlite:////path/to/agent-state.db
LAS_DATABASE_URL=
LAS_STATE_DB=                                    # (AGENT_STATE_DB) 仅 SQLite 时用，缺省 $LAS_WORKSPACE/runtime/agent-state.db

# ── NATS / JetStream ──
LAS_NATS_URL=nats://127.0.0.1:4222               # (NATS_URL)

# ── agentgateway（留空 = hermes 直连 adapter，不经 gateway）──
LAS_GATEWAY_URL=                                 # (AGENT_GATEWAY_URL) 如 http://127.0.0.1:8300
LAS_GATEWAY_API_KEY=                             # (GATEWAY_API_KEY)
# 跨主机客户端改用 https:// + strict JWT + mTLS；以下文件必须在客户端可读，
# JWT 文件用原子替换轮换并 chmod 600。单机 loopback 剖面全部留空。
LAS_GATEWAY_JWT_FILE=
LAS_GATEWAY_CA_FILE=
LAS_GATEWAY_CLIENT_CERT_FILE=
LAS_GATEWAY_CLIENT_KEY_FILE=

# ── 外部总控接入（orchestrator A2A 端点，:8310）──
# 自建 hermes 等总控系统经 A2A 调用 agentHub；契约见 docs/orchestrator-a2a.md
# 留空则回退 LAS_ADAPTER_TOKEN（单租户可共用）；compose 要求至少配置其一，
# 均空只允许手工 loopback 开发启动。
LAS_API_TOKEN=
# A2A v1.0 Bearer peer 映射（单行 JSON：token → {peer, worker}）。
# 每个 token 是总控侧注册的一个逻辑 peer，服务端按认证 identity 固定路由到
# 映射 worker（不信任请求体的 metadata.agent）；协议白名单为 codex/kimi/dsh，
# 但当前 production-preflight 会阻断 dsh peer，直到原生权限强制完成验证。
# token 用 openssl rand -hex 24 生成；只存本文件并转交对端，勿入仓。
# 例：LAS_A2A_PEERS={"<token-a>":{"peer":"qishuo-codex","worker":"codex"},"<token-b>":{"peer":"qishuo-kimi","worker":"kimi"}}
LAS_A2A_PEERS=
# compose 固定 true；认证全空或生产 token 少于 16 字符时拒绝启动。
LAS_ORCH_REQUIRE_AUTH=true

# ── Hindsight 长期记忆（可选；不配置则静默跳过记忆写入）──
LAS_HINDSIGHT_URL=http://127.0.0.1:18888         # (HINDSIGHT_API_URL)
LAS_HINDSIGHT_API_KEY=                           # (HINDSIGHT_API_KEY)

# ── Worker adapter 心跳 ──
LAS_HEARTBEAT_INTERVAL=30                        # (AGENT_HEARTBEAT_INTERVAL) 秒
LAS_LEASE_TTL=90                                 # (AGENT_LEASE_TTL) 秒

# ── Worker adapter 调用方鉴权与绑定（宿主机 adapter 用）──
# 非空时 adapter 除 /health 外均要求 X-Agent-Token 头匹配；
# hermes（直连或经 gateway 透传）自动携带。
# 留空时 agent-worker.sh 启动会自动生成随机值回写本文件（仅初始化时打日志）。
# 修改本值后：launchctl kickstart -k 重启 adapter + 重跑 agentctl 即生效。
LAS_ADAPTER_TOKEN=
# 监听地址（逗号分隔，在此文件配置，不要改代码）；单个地址不可用时跳过
LAS_ADAPTER_BIND=127.0.0.1,192.168.7.10
# LAS_ADAPTER_PORT=8201                          # 缺省：codex 8201 / kimi 8202 / dsh 8203

# ── kimi worker（真实本地 Kimi Code CLI，~/.kimi-code/bin/kimi）──
# 认证在 CLI 侧一次性完成：kimi login（OAuth）或 Moonshot API key。
# 缺省模型用 CLI 配置的 default_model；下方变量可覆盖（kimi -m <alias>）。
# LAS_KIMI_CLI_MODEL=kimi-code/kimi-for-coding

# ── DSH worker（本地 DeepSeek Harness Web API）──
# 先独立启动：dsh web --host 127.0.0.1 --port 3080
# AgentHub Adapter 只连接本地 API；DSH 仍可通过自己的 Web UI 独立使用。
LAS_DSH_WEB_URL=http://127.0.0.1:3080
# DSH rc.7 通过 commands.execute 应用原生 /permission read-only；Adapter
# 还会核验 sandbox=read-only、approval=ask，并强制使用已审计的 standard preset。
# 当前保持 false，待生产 catalog/peer 切换批次统一放行。
LAS_DSH_PRODUCTION_ENABLED=false
# 旧版开发兼容开关；新实现不再依赖它放行模型提示。生产必须保持 false。
LAS_DSH_ALLOW_UNVERIFIED_RUNTIME=false
# 唯一允许值；每次新建/恢复原生 session 都会重新应用并从历史核验。
LAS_DSH_PERMISSION_PRESET=read-only
# ActionIntent receipt HMAC；生产请单独生成（openssl rand -hex 32）。为空时
# 暂时回退 LAS_ADAPTER_TOKEN；两者都为空则所有 allowed-once 均 fail-closed。
LAS_ACTION_RECEIPT_SECRET=
# AgentHub 强制值。minimal 的 str_replace_editor 已实测会绕过 read-only。
LAS_DSH_AGENT_PRESET=standard

# ── WebUI 控制面认证（compose 必填，未配置时 WebUI fail-closed）──
# token→role JSON；role：viewer（只读）、operator（审批/介入）、admin（含常驻授权）。
# 每个 token 用 `openssl rand -hex 24` 生成；可配置多个账号，不要把真实值提交。
# 例：LAS_WEBUI_TOKENS={"<token-a>":"admin","<token-b>":"viewer"}
LAS_WEBUI_TOKENS=
# 签名 HttpOnly session cookie 的独立 HMAC 密钥：`openssl rand -hex 32`
LAS_WEBUI_SESSION_SECRET=
LAS_WEBUI_SESSION_TTL=28800
# 只有通过 HTTPS 访问时设 true；默认 loopback HTTP 必须为 false，否则浏览器不回传 cookie。
LAS_WEBUI_COOKIE_SECURE=false
LAS_WEBUI_REQUIRE_AUTH=true

# ── 数据库迁移门禁（compose 固定启用）──
# 有待执行 migration 时必须存在 24 小时内由已验证备份生成的一次性回执；
# migration 全部成功后回执自动删除，不能复用。日常无需手工设置 receipt 路径。
LAS_REQUIRE_MIGRATION_BACKUP=true
LAS_MIGRATION_BACKUP_MAX_AGE=86400

# ── 告警路由（告警始终持久化并显示在 WebUI；webhook 可选）──
# 非 loopback 必须使用 HTTPS；Bearer token 至少 16 字符。投递失败指数退避，
# 连续 3 次失败自动把告警升级为 critical，但不会丢弃或阻塞 WebUI 确认。
LAS_ALERT_WEBHOOK_URL=
LAS_ALERT_WEBHOOK_TOKEN=
LAS_ALERT_POLL_INTERVAL=10
LAS_ALERT_WEBHOOK_TIMEOUT=10

# ── 测试门控（仅开发用）──
# LAS_RUN_LLM=1    放行真实 LLM 集成测试
# LAS_RUN_CODEX=1  放行真实 codex CLI 集成测试
# LAS_RUN_DSH=1    放行真实 DSH Web API 集成测试
# LAS_RUN_GW=1     放行 agentgateway 验收测试
# LAS_RUN_RESTORE_DRILL=1  放行独立临时 Compose 备份恢复演练
