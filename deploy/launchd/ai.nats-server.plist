<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.nats-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nats-server</string>
        <string>-js</string>
        <string>-m</string>
        <string>8222</string>
        <string>--store_dir</string>
        <string>/Users/evergarden/AgentWorkspace/runtime/jetstream</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/evergarden/AgentWorkspace/logs/nats-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/evergarden/AgentWorkspace/logs/nats-server.err.log</string>
</dict>
</plist>
